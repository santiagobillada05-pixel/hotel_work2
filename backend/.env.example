APP_NAME=HotelWork
DEBUG=True

# --- DATABASE CONFIGURATION ---
# Opción 1: SQLite local (desarrollo local sencillo)
# DATABASE_URL=sqlite:///./hotelwork.db

# Opción 2: Supabase / PostgreSQL (RECOMENDADA para producción y cloud)
# DATABASE_URL=postgresql://postgres.[TU-PROYECTO]:[TU-CONTRASEÑA]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# O conexión directa Supabase:
# DATABASE_URL=postgresql://postgres:[TU-CONTRASEÑA]@db.[TU-PROYECTO].supabase.co:5432/postgres?sslmode=require

# Opción 3: MySQL (ej. local XAMPP o cloud)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/hotelwork

DATABASE_URL=sqlite:///./hotelwork.db
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
TAX_RATE=0.19
DEFAULT_DISCOUNT_RATE=0.0
CORS_ORIGINS=http://localhost:5173
DEFAULT_ADMIN_EMAIL=agudelosantiago.inedan@gmail.com
DEFAULT_ADMIN_PASSWORD=change-admin-password-here
